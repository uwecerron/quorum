# Copy to .env.local (git-ignored) or set in Vercel → Settings → Environment Variables.
# Your GoldRush (Covalent) API key. Keys start with "cqt_".
# Get one free at https://goldrush.dev — the key stays server-side (used by /api/gass
# and scripts/gass.mjs); it is never exposed to the browser.
GOLDRUSH_API_KEY=cqt_your_key_here
